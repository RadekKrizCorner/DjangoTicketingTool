# Copy this file to .env before running docker-compose.release.yml.
# Replace all secrets before exposing the stack to the internet.

# Published images
APP_IMAGE=ghcr.io/radekkrizcorner/djangoticketingtool/api:latest
WEB_IMAGE=ghcr.io/radekkrizcorner/djangoticketingtool/web:latest
PUBLIC_PORT=48137

# Django runtime
DJANGO_SECRET_KEY=replace-with-output-of-openssl-rand-hex-32
DJANGO_ALLOWED_HOSTS=radekkriz.space,www.radekkriz.space,localhost,127.0.0.1,api
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=https://radekkriz.space,https://www.radekkriz.space,http://radekkriz.space:48137,http://www.radekkriz.space:48137
DJANGO_HEALTHCHECK_HOST=localhost
DJANGO_SECURE_SSL_REDIRECT=false

# Demo bootstrap and seeded data
DEMO_SUPERUSER_EMAIL=demo.admin@example.com
DEMO_SUPERUSER_PASSWORD=DemoAdmin123!
DEMO_SUPERUSER_DISPLAY_NAME=Demo Admin
DEMO_USER_PASSWORD=DemoUser123!

# PostgreSQL
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=replace-with-strong-postgres-password

# Email
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=noreply@radekkriz.space

# Observability and Cloudflare Access protected Grafana
PUBLIC_GRAFANA_URL=https://grafana.radekkriz.space
OBSERVABILITY_METRICS_ENABLED=true
OBSERVABILITY_SLOW_QUERY_SECONDS=0.5
PROMETHEUS_RETENTION_TIME=7d
PROMETHEUS_RETENTION_SIZE=512MB
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-password
GRAFANA_LOCAL_PORT=3000
GRAFANA_ANONYMOUS_ENABLED=true
CLOUDFLARED_TOKEN=replace-with-cloudflare-tunnel-token
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
CELERY_EXPORTER_IMAGE=danihodovic/celery-exporter:latest

# Attachment quotas
ATTACHMENT_MAX_FILE_SIZE_BYTES=1048576
ATTACHMENT_MAX_PROJECT_BYTES=20971520
ATTACHMENT_MAX_TOTAL_BYTES=209715200

# Optional Docker writable-layer limits used by docker-compose.release.storage.yml
APP_CONTAINER_STORAGE_LIMIT=1G
WEB_CONTAINER_STORAGE_LIMIT=512M
DB_CONTAINER_STORAGE_LIMIT=2G
REDIS_CONTAINER_STORAGE_LIMIT=512M
MAILPIT_CONTAINER_STORAGE_LIMIT=512M
